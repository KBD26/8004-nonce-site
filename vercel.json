{
  "redirects": [
    { "source": "/", "destination": "https://8004nonce.eth.limo/", "permanent": false },
    { "source": "/:path*", "destination": "https://8004nonce.eth.limo/:path*", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
